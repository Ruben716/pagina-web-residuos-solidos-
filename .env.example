# Variables del servidor. Ninguno de estos archivos se sube al repositorio.
#
#   .env        → claves de Docker (docker compose las lee solo): POSTGRES_PASSWORD y el primer administrador
#   .env.local  → variables de la aplicación (Facebook y, opcionalmente, DATABASE_URL en desarrollo)

# ===================== .env (Docker) =====================

# Contraseña de la base PostgreSQL del contenedor "db". Larga y aleatoria.
POSTGRES_PASSWORD=

# Primer administrador del panel: si la base no tiene usuarios, se crea solo al abrir /panel.
# La contraseña es temporal (mín. 10 caracteres): el panel obliga a cambiarla al entrar.
# Después de crearse ya no se usan; cambiarlas no modifica la cuenta.
PANEL_ADMIN_EMAIL=
PANEL_ADMIN_PASSWORD=
PANEL_ADMIN_NAME=

# Alternativa a lo anterior: código para crear el primer administrador a mano en /panel/ingresar.
# Sin PANEL_ADMIN_* ni este código, en producción no se puede crear (nadie se adelanta al publicar).
PANEL_SETUP_TOKEN=

# Solo para probar el panel sin HTTPS desde otra PC o celular de la red (http://192.168…).
# En producción con HTTPS déjalo vacío: la cookie de sesión debe ser "Secure".
PANEL_INSECURE_COOKIE=

# ===================== .env.local (aplicación) =====================

# --- Base de datos ---
# Vacío en desarrollo: se usa PGlite (Postgres embebido en .data/pglite), sin instalar nada.
# En Docker la pone compose.yaml.
DATABASE_URL=

# --- Facebook: sección /actualidad y bloque "Lo último que publicamos" de la portada ---
# Token de acceso de la PÁGINA (de larga duración), con el permiso pages_read_engagement.
# Solo lo lee el servidor; nunca llega al navegador. Sin token, la sección muestra un aviso.
FACEBOOK_PAGE_TOKEN=

# Opcional. ID de la página; vacío = la página dueña del token.
FACEBOOK_PAGE_ID=

# Opcional. Enlace del botón "Seguir en Facebook"; vacío = el de la página del token.
FACEBOOK_PAGE_URL=
